# Server only. Never prefix these with VITE_.
# auto prefers TypeSafe when its key exists, otherwise OpenRouter. No runtime failover.
JEV_PROVIDER=auto
# With both keys set, the other provider is a disclosed one-time fallback. JEV_FALLBACK=0 disables it.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
# Legacy JEV_MODEL remains supported; the two known 1.13 IDs translate across providers.
# One clearly labeled LLM brief per submitted theme; Jev still chooses all notes.
# The director needs OPENROUTER_API_KEY even when Jev uses TypeSafe directly.
DIRECTOR_ENABLED=1
DIRECTOR_MODEL=openai/gpt-5.6-luna
HOST=127.0.0.1
PORT=4310
# Required when HOST is not a loopback address. Enter in the host panel.
CONTROLLER_TOKEN=
# Optional exact frontend origin for a separately hosted stage.
STAGE_ORIGIN=
# Hard per-jam request ceiling, including failed attempts.
MAX_JEV_REQUESTS=6000
# Optional, offline crowd-bank generation only; never used by audience browsers.
ELEVENLABS_API_KEY=

# Archive storage. Omit DATABASE_URL for local SQLite.
DATABASE_URL=
ARCHIVE_SQLITE_PATH=data/jtb.sqlite
ARCHIVE_TIMEZONE=America/New_York
# Migration only: supply a reachable Railway Postgres connection securely.
ARCHIVE_TARGET_DATABASE_URL=
