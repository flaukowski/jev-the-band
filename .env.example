# Server only. Never prefix these with VITE_.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# One clearly labeled LLM brief per submitted theme; Jev still chooses all notes.
DIRECTOR_ENABLED=1
DIRECTOR_MODEL=openai/gpt-5.6-luna
HOST=127.0.0.1
PORT=4310
# Required when HOST is not a loopback address. Enter in the host panel.
CONTROLLER_TOKEN=
# Optional exact frontend origin for a separately hosted stage.
STAGE_ORIGIN=
# Hard per-jam request ceiling, including failed attempts.
MAX_JEV_REQUESTS=6000
# Optional, offline crowd-bank generation only; never used by audience browsers.
ELEVENLABS_API_KEY=
