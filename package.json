{
  "name": "jev-the-band",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Six decision personas. One evolving live band.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,stage \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:performance": "tsx scripts/smoke-performance.ts",
    "audit:prompts": "tsx scripts/audit-prompts.ts",
    "audit:groove": "tsx scripts/audit-groove.ts",
    "audit:director": "tsx scripts/audit-director.ts",
    "format": "prettier --write src server shared scripts tests *.json *.ts",
    "audit:solos": "tsx scripts/audit-solos.ts",
    "audit:transition": "tsx scripts/audit-transition.ts",
    "generate:audience": "tsx scripts/generate-audience.ts",
    "promote:audience": "tsx scripts/promote-audience.ts",
    "archive:migrate": "tsx scripts/migrate-archive.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zod": "^4.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@types/pg": "^8.23.1"
  }
}
