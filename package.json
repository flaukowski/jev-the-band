{
  "name": "jev-the-band",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Five decision models. One improvising band.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,stage \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:performance": "tsx scripts/smoke-performance.ts",
    "audit:prompts": "tsx scripts/audit-prompts.ts",
    "audit:groove": "tsx scripts/audit-groove.ts",
    "format": "prettier --write src server shared scripts tests *.json *.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
